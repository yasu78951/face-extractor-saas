# ============================================================
# ベストショット抽出 SaaS — 環境変数
# このファイルを .env.local にコピーして値を入れてください。
# 値が空の間は「デモモード」（ログイン・課金なし）で起動します。
# ============================================================

# ---------- Supabase（Auth + PostgreSQL） ----------
# Supabase ダッシュボード → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role キーはサーバー専用。絶対に NEXT_PUBLIC_ を付けない・クライアントに渡さない。
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Stripe（サブスクリプション + Webhook + Customer Portal） ----------
# Stripe ダッシュボード → 開発者 → APIキー
STRIPE_SECRET_KEY=
# 月額500円（JPY・継続）のPrice ID（price_...）
STRIPE_PRICE_ID=
# Webhook の署名シークレット（whsec_...）
STRIPE_WEBHOOK_SECRET=
# 任意: カスタマーポータルの設定ID（bpc_...）。未設定ならダッシュボードの既定設定。
STRIPE_PORTAL_CONFIGURATION_ID=

# ---------- 公開URL ----------
# 本番: https://your-domain.example
# ローカル: http://localhost:3000
# 未設定の場合、Vercel では VERCEL_URL から自動で組み立てます。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- 特定商取引法に基づく表記 / サービス名（任意・推奨） ----------
# 未設定でもデフォルト値で表示されますが、Stripe本番審査の前に必ず実際の情報を入れてください。
NEXT_PUBLIC_SERVICE_NAME=ベストショット抽出ツール
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_REPRESENTATIVE=
# 所在地・電話番号は、空欄なら「請求があった場合に遅滞なく開示いたします」と表示されます。
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_OPERATOR_PHONE=
# 特商法表記およびプライバシーポリシーに載せるサポート窓口（必ず実在するアドレスに変更）
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PRICE_LABEL=月額500円（税込）
NEXT_PUBLIC_LEGAL_EFFECTIVE_DATE=2026年11月24日
